# Put one key in this file (copy to .env — that file is gitignored).
# OpenAI: https://platform.openai.com/api-keys
# Gemini: https://aistudio.google.com/apikey

OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# GEMINI_API_KEY=
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Photos stay on this machine for first production (data/uploads, EU VPS).
# Switch later to S3-compatible storage (Cloudflare R2 or Hetzner Object Storage)
# when you need more than one app server or outgrow the VPS disk.
STORAGE=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Google Calendar — connect once, then saves create events automatically.
# Cloud Console: APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8767/app/google/callback

# Reminder emails go to the account address (30/14/7/1 days).
# 1. https://resend.com/signup  → API Keys → Create
# 2. Put the key in RESEND_API_KEY
# 3. python -m app.mail test you@email.com
# 4. Production domain: Resend → Domains → add e.g. snapandforget.app
#    DNS: SPF, DKIM, (DMARC). Then set MAIL_FROM=Name <reminders@your-domain>
# Daily job: python -m app.reminders
# Daily job also syncs Stripe paid/free if a webhook was missed.
# curl -H "X-Cron-Secret: $CRON_SECRET" $APP_BASE_URL/internal/reminders
# Customer steps: python -m app.activity
#                 python -m app.activity user you@email.com
# Keep event + mail rows forever while you have few users.
# Later, e.g. after 100k clients: EVENT_LOG_DAYS=730
#    dry-run: python -m app.activity purge --days 730
#    apply:   python -m app.activity purge --days 730 --yes
# EVENT_LOG_DAYS=
# Log: python -m app.mail log
# EU alternative without code change: Brevo SMTP (smtp-relay.brevo.com) in SMTP_*.
MAIL_MODE=production
MAIL_FROM=Snap & Forget <beth.t@example.com>
# MAIL_FROM=Odfot a zabudni <reminders@your-domain.com>
MAIL_REPLY_TO=
# OPERATOR_EMAIL=you@email.com
# Warnings: missed webhook, Stripe/app mismatch, cron silent, reminder errors.
APP_BASE_URL=http://127.0.0.1:8767
# Production: ALLOWED_HOSTS=snapforgot.com,www.snapforgot.com
# Behind nginx/Caddy set TRUST_PROXY=1 so rate limits see the real IP.
# COOKIE_SECURE is auto-on when APP_BASE_URL is https.
# APP_DEBUG=1 enables /docs — leave off in production.
# SCAN_PER_DAY=20
# Dashboard card titles. Cut at a word, then …. Full name stays on the document.
# CARD_TITLE_MAX=32
# ALLOWED_HOSTS=
# TRUST_PROXY=0
# Shown on /privacy and /terms (controller). Email falls back to MAIL_FROM.
# LEGAL_NAME=Your name or company
# LEGAL_EMAIL=privacy@your-domain.com
# LEGAL_ADDRESS=Street, City, Country
# Admin list at /admin. Shorter than 16 characters (or empty) → that URL 404s.
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# Stripe — STRIPE_AMOUNT_CENTS is what Checkout charges (100 = €1.00, 1990 = €19.90).
# Dashboard Price ID still needed so the charge sits on the Snap & Forget product.
# Customer portal: Settings → Billing → Customer portal → enable.
# Local: stripe listen --forward-to localhost:8767/internal/stripe
# STRIPE_SECRET_KEY=sk_test_
# STRIPE_WEBHOOK_SECRET=whsec_
# STRIPE_PRICE_ID=price_
# STRIPE_AMOUNT_CENTS=1990
CRON_SECRET=
# Cron secret must be at least 16 characters. Query-string secrets are rejected.
# curl -H "X-Cron-Secret: $CRON_SECRET" $APP_BASE_URL/internal/reminders
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1
